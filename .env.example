# Copy this file to .env for local runs. Never commit .env.
# In Azure DevOps / Airflow these same names are injected as environment variables.

# --- Process -----------------------------------------------------------------
RPA_PROCESS_NAME=sample_login
RPA_ENGINE=selenium                 # selenium | playwright
RPA_HEADLESS=false                  # true | false
RPA_BASE_URL=https://the-internet.herokuapp.com
RPA_TIMEOUT_SECONDS=30
RPA_MAX_RETRIES=3

# --- Secrets (demo-site credentials; use real ones only in .env / Key Vault) --
RPA_USERNAME=tomsmith
RPA_PASSWORD=SuperSecretPassword!

# --- OpenTelemetry (optional; run with: opentelemetry-instrument python main.py)
# OTEL_SERVICE_NAME=rpa-sample-login
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=none
# OTEL_LOGS_EXPORTER=otlp
