        </mxCell>
        <mxCell id="obsNote" value="&lt;b&gt;Error policy&lt;/b&gt;&lt;br&gt;&lt;br&gt;• SystemException → retry (RPA_MAX_RETRIES = 3)&lt;br&gt;• BusinessException → no retry&lt;br&gt;• Every failed attempt: screenshot + log&lt;br&gt;• Browser always closed in finally" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#b85450;rounded=1;spacing=10;" vertex="1" parent="obs">
          <mxGeometry x="20" y="45" width="260" height="130" as="geometry" />
        </mxCell>

        <!-- Rules legend -->
        <mxCell id="rules" value="&lt;b&gt;Layering rules&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Dependencies only point down.&lt;br&gt;&lt;br&gt;2. Tasks never contain locators.&lt;br&gt;&lt;br&gt;3. Pages never call other pages and hold no business logic.&lt;br&gt;&lt;br&gt;4. Only core/engines/ imports Selenium or Playwright.&lt;br&gt;&lt;br&gt;5. Tasks share data only through context.&lt;br&gt;&lt;br&gt;6. process.py defines the task order.&lt;br&gt;&lt;br&gt;&lt;b&gt;Locator prefixes&lt;/b&gt;&lt;br&gt;BTN_ TXT_ LBL_ LNK_ CHK_&lt;br&gt;RDO_ DDL_ TBL_ MDL_ IFR_&lt;br&gt;&lt;br&gt;CSS first · xpath= only if needed&lt;br&gt;Never time.sleep()" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;rounded=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="260" height="470" as="geometry" />
        </mxCell>

